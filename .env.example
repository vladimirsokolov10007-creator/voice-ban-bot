# Токен бота: Discord Developer Portal -> Bot -> Token
DISCORD_TOKEN=вставьте_токен_сюда

# Движок распознавания: groq (облако, нужен ключ) или local (свой Python + Whisper)
# STT_ENGINE=groq

# Ключ Groq API: console.groq.com -> API Keys (бесплатно, без карты)
# GROQ_API_KEY=gsk_...
# GROQ_MODEL=whisper-large-v3-turbo

# --- Ниже настройки только для движка local ---

# Команда запуска Python с установленными зависимостями
# PYTHON_PATH=.venv/Scripts/python.exe

# Модель Whisper: tiny / base / small / medium (по умолчанию small)
# WHISPER_MODEL=small

# Устройство: cpu (по умолчанию) или cuda, если есть NVIDIA GPU
# WHISPER_DEVICE=cpu
